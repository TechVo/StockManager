@* Grid of stock rows with sorting. The quantity column contains an editor for each row. *@

@if (!Rows.Any())
{
    <p class="message">Filtru neodpovídá žádná položka.</p>
}
else
{
    <QuickGrid Items="Rows" ItemKey="@(row => (row.ClientId, row.ProductId))" Class="stock-grid">
        <TemplateColumn Title="Klient" SortBy="ByClient" IsDefaultSortColumn="true">
            @context.ClientName
        </TemplateColumn>
        <TemplateColumn Title="Kategorie">
            @string.Join(", ", context.Categories.Order())
        </TemplateColumn>
        <PropertyColumn Title="Produkt" Property="row => row.ProductName" Sortable="true" />
        <TemplateColumn Title="Počet kusů" SortBy="ByQuantity" Class="quantity-column">
            <QuantityEditor Row="context" QuantitySaved="quantity => QuantitySaved.InvokeAsync((context, quantity))" />
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private static readonly GridSort<StockRowDto> ByClient =
        GridSort<StockRowDto>.ByAscending(row => row.ClientName).ThenAscending(row => row.ProductName);

    private static readonly GridSort<StockRowDto> ByQuantity =
        GridSort<StockRowDto>.ByAscending(row => row.Quantity);

    /// <summary>Returns the rows with a saved quantity, for pages that keep sorting by quantity correct.</summary>
    public static IQueryable<StockRowDto> WithSavedQuantity(IQueryable<StockRowDto> rows, (StockRowDto Row, int Quantity) saved) =>
        rows
            .AsEnumerable()
            .Select(row => row.ClientId == saved.Row.ClientId && row.ProductId == saved.Row.ProductId
                ? row with { Quantity = saved.Quantity }
                : row)
            .ToList()
            .AsQueryable();

    [Parameter, EditorRequired]
    public required IQueryable<StockRowDto> Rows { get; set; }

    [Parameter]
    public EventCallback<(StockRowDto Row, int Quantity)> QuantitySaved { get; set; }
}
