@* Grid of stock rows with sorting. Clients, categories and products are links to their detail pages,
   and the quantity column contains an editor for each row. *@

@if (!Rows.Any())
{
    <p class="message">Filtru neodpovídá žádná položka.</p>
}
else
{
    <QuickGrid Items="Rows" ItemKey="@(row => (row.ClientId, row.ProductId))" Class="stock-grid">
        <TemplateColumn Title="Klient" SortBy="ByClient" IsDefaultSortColumn="true">
            <RecordLink Code="@context.ClientCode" Name="@context.ClientName" />
        </TemplateColumn>
        <TemplateColumn Title="Kategorie" SortBy="ByCategories">
            <CategoryLinks Categories="context.Categories" />
        </TemplateColumn>
        <TemplateColumn Title="Produkt" SortBy="ByProduct">
            <RecordLink Code="@context.ProductCode" Name="@context.ProductName" />
        </TemplateColumn>
        <TemplateColumn Title="Počet kusů" SortBy="ByQuantity" Class="quantity-column">
            <QuantityEditor Row="context" QuantitySaved="quantity => QuantitySaved.InvokeAsync((context, quantity))" />
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private static readonly GridSort<StockRowDto> ByClient =
        GridSort<StockRowDto>.ByAscending(row => row.ClientName).ThenAscending(row => row.ProductName);

    private static readonly GridSort<StockRowDto> ByProduct =
        GridSort<StockRowDto>.ByAscending(row => row.ProductName);

    private static readonly GridSort<StockRowDto> ByCategories =
        GridSort<StockRowDto>.ByAscending(row => FormatCategories(row)).ThenAscending(row => row.ClientName).ThenAscending(row => row.ProductName);

    private static readonly GridSort<StockRowDto> ByQuantity =
        GridSort<StockRowDto>.ByAscending(row => row.Quantity);

    /// <summary>Returns the category names of a row as one sorted text, for sorting the column.</summary>
    private static string FormatCategories(StockRowDto row) => string.Join(", ", row.Categories.Select(category => category.Name).Order());

    /// <summary>Returns the rows with a saved quantity, for pages that keep sorting by quantity correct.</summary>
    public static IQueryable<StockRowDto> WithSavedQuantity(IQueryable<StockRowDto> rows, (StockRowDto Row, int Quantity) saved) =>
        rows
            .AsEnumerable()
            .Select(row => row.ClientId == saved.Row.ClientId && row.ProductId == saved.Row.ProductId
                ? row with { Quantity = saved.Quantity }
                : row)
            .ToList()
            .AsQueryable();

    [Parameter, EditorRequired]
    public required IQueryable<StockRowDto> Rows { get; set; }

    [Parameter]
    public EventCallback<(StockRowDto Row, int Quantity)> QuantitySaved { get; set; }
}
