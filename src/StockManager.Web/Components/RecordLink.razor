@* Link to the detail page of a record. Hovering over it or focusing it shows a tooltip with the code and an icon button that copies the code. The icon and its title show the result. *@
@inject IJSRuntime JS

<span class="record-link" @onmouseleave="ClearResult">
    <a href="@($"detail/{Code}")">@Name</a>
    <span class="record-tooltip">
        <code>@Code</code>
        <button type="button" class="link-button copy-button" title="@Title" aria-label="@Title" @onclick="CopyAsync">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                @if (_copied == true)
                {
                    <path d="M5 13l4 4L19 7" />
                }
                else if (_copied == false)
                {
                    <path d="M6 6l12 12M18 6L6 18" />
                }
                else
                {
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                }
            </svg>
        </button>
    </span>
</span>

@code {
    private bool? _copied;

    [Parameter, EditorRequired]
    public required string Code { get; set; }

    [Parameter, EditorRequired]
    public required string Name { get; set; }

    /// <summary>Text of the button for the current result of copying.</summary>
    private string Title => _copied switch
    {
        true => "Zkopírováno",
        false => "Nelze kopírovat",
        null => "Kopírovat kód",
    };

    /// <summary>Copies the code to the clipboard and shows the result on the button.</summary>
    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Code);
            _copied = true;
        }
        catch (JSException)
        {
            // the browser allows the clipboard only on HTTPS or localhost, or the user denied the access
            _copied = false;
        }
    }

    /// <summary>Returns the button to its first icon when the mouse leaves the link.</summary>
    private void ClearResult() => _copied = null;
}
