@* Number input of one grid row. After a change it shows the old and the new value, a button that saves the new one
   and an icon button that returns the saved one. Enter also saves.
   The input is read only during the save, so that a late response cannot replace a newer value. *@
@inject StockApiClient Api

<div class="quantity-editor">
    <input @key="_inputVersion" type="number" min="0" max="@UpdateStockRequest.MaxQuantity" step="1"
           class="@(_error is null ? null : "invalid")"
           aria-label="@($"Počet kusů: {Row.ProductName}, {Row.ClientName}")"
           readonly="@_saving"
           value="@Row.Quantity" @oninput="OnInput" @onkeydown="OnKeyDownAsync" />
    @if (_unsavedText is not null)
    {
        <button type="button" disabled="@_saving" @onclick="SaveAsync">Uložit</button>
        <button type="button" class="reset-button" title="Zahodit změnu" aria-label="Zahodit změnu" disabled="@_saving" @onclick="Reset">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 3-6.7" />
                <path d="M3 4v5h5" />
            </svg>
        </button>
        <span class="quantity-change">@Row.Quantity → @_unsavedText</span>
    }
    @if (_error is not null)
    {
        <span class="quantity-error" role="alert">@_error</span>
    }
    else if (_saved)
    {
        <span class="quantity-saved">Uloženo</span>
    }
</div>

@code {
    private string? _unsavedText;
    private int _inputVersion;
    private string? _error;
    private bool _saved;
    private bool _saving;

    [Parameter, EditorRequired]
    public required StockRowDto Row { get; set; }

    [Parameter]
    public EventCallback<int> QuantitySaved { get; set; }

    /// <summary>Remembers the changed value. A return to the saved value leaves nothing to save.</summary>
    private void OnInput(ChangeEventArgs change)
    {
        var text = change.Value as string ?? "";

        _unsavedText = text == Row.Quantity.ToString() ? null : text;
        _error = null;
        _saved = false;
    }

    /// <summary>Returns the input to the saved value and removes the error of the changed value.</summary>
    private void Reset()
    {
        // a new input shows the saved value, because the rendered value of the old one did not change and Blazor would not update it
        _inputVersion++;

        _unsavedText = null;
        _error = null;
    }

    /// <summary>Saves the value when the user presses Enter.</summary>
    private async Task OnKeyDownAsync(KeyboardEventArgs key)
    {
        if (key.Key == "Enter")
        {
            await SaveAsync();
        }
    }

    /// <summary>Saves the changed value and shows the result.</summary>
    private async Task SaveAsync()
    {
        // there is nothing to save, or the save is already running
        if (_unsavedText is null || _saving)
        {
            return;
        }

        // a value that is not a whole number cannot be sent, the range is checked by the server
        if (!int.TryParse(_unsavedText, out var quantity))
        {
            _error = StockApiClient.InvalidQuantityMessage;
            return;
        }

        // save the value
        _saving = true;
        _error = await Api.UpdateQuantityAsync(Row.ClientId, Row.ProductId, quantity);
        _saving = false;

        // tell the page only about a value that was saved, after an error the button stays for another attempt
        if (_error is null)
        {
            _unsavedText = null;
            _saved = true;
            await QuantitySaved.InvokeAsync(quantity);
        }
    }
}
