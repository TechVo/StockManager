@* Detail of a client, a category or a product, shown read only. The prefix of the code tells the record type.
   The stock rows of the record are below it, and the quantity is the only value that can be changed. *@
@page "/detail/{Code}"
@implements IDisposable
@inject StockApiClient Api

<header class="page-header">
    <h1>Správa skladu</h1>
</header>

<div class="detail-body">
    <a href="">← Zpět na přehled</a>

    @if (_error is not null)
    {
        <p class="message message-error" role="alert">@_error</p>
    }
    else if (_notFound)
    {
        <p class="message" role="alert">Záznam s kódem @Code neexistuje.</p>
    }
    else if (_detail is null || _rows is null)
    {
        <p class="message">Načítám…</p>
    }
    else
    {
        <section class="detail-panel">
            <h2>@RecordTypeText.GetName(_type) @_detail.Code</h2>
            <p>Název: @_detail.Name</p>
            @if (_type != RecordType.Category)
            {
                <p>Kategorie: <CategoryLinks Categories="_detail.Categories" /></p>
            }
        </section>

        <main class="grid-panel">
            <StockGrid Rows="_rows" QuantitySaved="OnQuantitySaved" />
        </main>
    }
</div>

@code {
    private RecordType _type;
    private RecordDetailDto? _detail;
    private IQueryable<StockRowDto>? _rows;
    private bool _notFound;
    private string? _error;
    private CancellationTokenSource? _loadCancellation;

    [Parameter]
    public required string Code { get; set; }

    /// <summary>Loads the record for the code in the address and its stock rows. A newer address cancels an older load that is still running.</summary>
    protected override async Task OnParametersSetAsync()
    {
        // cancel the previous load, so that its late response cannot replace the data of this address
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        var cancellationToken = _loadCancellation.Token;

        // the data of a previous address is no longer valid
        _detail = null;
        _rows = null;
        _notFound = false;
        _error = null;

        // a code with an unknown prefix cannot belong to any record
        if (RecordCode.GetRecordType(Code) is not { } type)
        {
            _notFound = true;
            return;
        }

        _type = type;

        try
        {
            // a record that does not exist has no stock rows to load
            var detail = await Api.GetDetailAsync(type, Code, cancellationToken);
            if (detail is null)
            {
                _notFound = true;
                return;
            }

            // show only the stock rows of this record
            var rows = await Api.GetStockAsync(CreateFilter(type, detail.Id), cancellationToken);
            _rows = rows.AsQueryable();
            _detail = detail;
        }
        catch (OperationCanceledException)
        {
            // a newer address replaced this load and will show its own result
        }
        catch (HttpRequestException)
        {
            _error = "Data se nepodařilo načíst. Zkuste obnovit stránku.";
        }
    }

    /// <summary>Returns the filter that selects the stock rows of one record.</summary>
    private static StockFilter CreateFilter(RecordType type, int id)
    {
        var filter = StockFilter.CreateEmpty();

        switch (type)
        {
            case RecordType.Client:
                filter = filter with { ClientIds = [id] };
                break;
            case RecordType.Category:
                filter = filter with { CategoryIds = [id] };
                break;
            case RecordType.Product:
                filter = filter with { ProductIds = [id] };
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(type), type, null);
        }

        return filter;
    }

    /// <summary>Updates the saved quantity in the local rows, so that sorting by quantity stays correct.</summary>
    private void OnQuantitySaved((StockRowDto Row, int Quantity) saved) =>
        _rows = StockGrid.WithSavedQuantity(_rows!, saved);

    /// <summary>Cancels the load that is still running when the user leaves the page.</summary>
    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
