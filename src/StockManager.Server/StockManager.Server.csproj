<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockManager.Web\StockManager.Web.csproj" />
    <ProjectReference Include="..\StockManager.Contracts\StockManager.Contracts.csproj" />
  </ItemGroup>

  <!-- the test data is read when the application starts -->
  <ItemGroup>
    <Content Include="Data\seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the server is built by every full build, so the diagram is rendered once and in one place -->
  <PropertyGroup>
    <ArchitectureDiagramBase>$(MSBuildThisFileDirectory)..\..\docs\architecture</ArchitectureDiagramBase>
  </PropertyGroup>

  <!-- render the architecture diagram when its source changed, Graphviz is optional so the build continues without it -->
  <Target Name="RenderArchitectureDiagram"
          AfterTargets="Build"
          Inputs="$(ArchitectureDiagramBase).dot"
          Outputs="$(ArchitectureDiagramBase).svg;$(ArchitectureDiagramBase).png">
    <Exec Command="dot -V"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="DotExitCode" />
    </Exec>
    <Message Condition="'$(DotExitCode)' != '0'" Importance="high" Text="Graphviz dot was not found, the architecture diagram was not rendered." />
    <Exec Condition="'$(DotExitCode)' == '0'" Command="dot -Tsvg &quot;$(ArchitectureDiagramBase).dot&quot; -o &quot;$(ArchitectureDiagramBase).svg&quot;" />
    <Exec Condition="'$(DotExitCode)' == '0'" Command="dot -Tpng -Gdpi=150 &quot;$(ArchitectureDiagramBase).dot&quot; -o &quot;$(ArchitectureDiagramBase).png&quot;" />
  </Target>

</Project>
